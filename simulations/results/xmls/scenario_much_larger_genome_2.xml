<beast version="2.0" namespace="beast.base.inference.parameter:beast.base.inference:remaster">
	<run spec="Simulator" nSims="1">
		<simulate spec="feast.simulation.SimulatedAlignment" outputFileName="results/remaster/simulated_nexus_much_larger_genome_2.nexus" sequenceLength="30000">
			<siteModel spec="beast.base.evolution.sitemodel.SiteModel" mutationRate="0.00001875062">
				<substModel spec="beast.base.evolution.substitutionmodel.JukesCantor"/>
			</siteModel>


			<tree spec="SimulatedTree" id="tree">
				<trajectory spec="StochasticTrajectory" id="traj" mustHave="sample[0]&gt;-1 &amp;&amp; sample[1]&gt;-1 &amp;&amp; sample[2]&gt;-1">

					<population spec="RealParameter" id="S" value="150000 150000 150000"/>
					<population spec="RealParameter" id="E" value="0 0 0"/>
					<population spec="RealParameter" id="I" value="1 0 0"/>
					<population spec="RealParameter" id="R" value="0 0 0"/>
					<samplePopulation spec="RealParameter" id="sample" value="0 0 0"/>

					<reaction spec="Reaction" rate="0.000002926"> I[0] + S[0] -> I[0] + E[0] </reaction>
					<reaction spec="Reaction" rate="0.0000000308"> I[0] + S[1] -> I[0] + E[1] </reaction>
					<reaction spec="Reaction" rate="0.0000001232"> I[0] + S[2] -> I[0] + E[2] </reaction>
					<reaction spec="Reaction" rate="0.0000000924"> I[1] + S[0] -> I[1] + E[0] </reaction>
					<reaction spec="Reaction" rate="0.000002926"> I[1] + S[1] -> I[1] + E[1] </reaction>
					<reaction spec="Reaction" rate="0.0000000616"> I[1] + S[2] -> I[1] + E[2] </reaction>
					<reaction spec="Reaction" rate="0.000000077"> I[2] + S[0] -> I[2] + E[0] </reaction>
					<reaction spec="Reaction" rate="0.000000077"> I[2] + S[1] -> I[2] + E[1] </reaction>
					<reaction spec="Reaction" rate="0.000002926"> I[2] + S[2] -> I[2] + E[2] </reaction>

					<reaction spec="Reaction" rate="0.33"> E[0] -> I[0] </reaction>
					<reaction spec="Reaction" rate="0.33"> E[1] -> I[1] </reaction>
					<reaction spec="Reaction" rate="0.33"> E[2] -> I[2] </reaction>

					<reaction spec="Reaction" rate="0.297"> I[0] -> R[0] </reaction>
					<reaction spec="Reaction" rate="0.297"> I[1] -> R[1] </reaction>
					<reaction spec="Reaction" rate="0.297"> I[2] -> R[2] </reaction>

					<reaction spec="Reaction" rate="0.033"> I[0] -> sample[0] </reaction>
					<reaction spec="Reaction" rate="0.033"> I[1] -> sample[1] </reaction>
					<reaction spec="Reaction" rate="0.033"> I[2] -> sample[2] </reaction>

				</trajectory>
			</tree>
		</simulate>

		<logger spec="Logger" fileName="results/remaster/simulated_traj_much_larger_genome_2.traj">
			<log idref="traj"/>
		</logger>

		 <logger spec="Logger" mode="tree" fileName="results/remaster/simulated_tree_much_larger_genome_2.trees">
			<log spec="TypedTreeLogger" tree="@tree" removeSingletonNodes="true"/>
		</logger>

		 <logger spec="Logger">
			<log spec="beast.base.evolution.tree.TreeStatLogger" tree="@tree"/>
		</logger>

	</run>
</beast>
